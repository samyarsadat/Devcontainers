{
    "id": "ros",
    "version": "0.0.0",
    "name": "ROS 2 Development",
    "description": "ROS 2 development tooling for C++ and Python.",
    "documentationURL": "https://github.com/samyarsadat/Devcontainers",
    "licenseURL": "https://github.com/samyarsadat/Devcontainers/blob/main/LICENSE",
    "installsAfter": [
        "ghcr.io/samyarsadat/devcontainers/features/foundation"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "althack.ament-task-provider",
                "Ranch-Hand-Robotics.rde-ros-2",
                "Ranch-Hand-Robotics.urdf-editor",
                "ms-vscode.cpptools",
                "ms-python.python",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "files.associations": {
                    "*.repos": "yaml",
                    "*.world": "xml",
                    "*.xacro": "xml"
                },
                "ament-task-provider.envSetup": "source /usr/local/lib/dev-environments/ros-setup.sh"
            }
        }
    }
}
