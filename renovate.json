{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "dependencyDashboardAutoclose": true,
    "schedule": ["* 0-5 * * MON"],
    "labels": ["dependencies"],
    "customManagers": [
        {
            "description": "update annotated dependencies in versions.env files",
            "customType": "regex",
            "managerFilePatterns": ["**/versions.env"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\r?\\n[A-Za-z_]\\w*=(?<currentValue>\\S+)",
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))? currentValue=(?<currentValue>\\S+)\\r?\\n[A-Za-z_]\\w*=(?<currentDigest>[0-9a-f]{40})(?:\\s|$)"
            ]
        }
    ]
}
